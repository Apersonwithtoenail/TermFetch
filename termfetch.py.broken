#!/usr/bin/env python3
"""termfetch — live system info with cava on the right."""

import os, re, sys, json, time, queue, select, shutil, platform
import threading, subprocess, termios, atexit

VERSION = "0.4.0"

# ---------- ANSI ----------
ESC = "\033["
ALT_ON      = ESC + "?1049h"
ALT_OFF     = ESC + "?1049l"
HOME        = ESC + "H"
CLEAR       = ESC + "2J"
HIDE_CURSOR = ESC + "?25l"
SHOW_CURSOR = ESC + "?25h"
RESET       = "\033[0m"

def fg(n): return f"{ESC}38;5;{n}m"
def rgb(r, g, b): return f"{ESC}38;2;{r};{g};{b}m"

AMBER = [208, 209, 210, 214, 215, 220, 221, 222, 220, 215, 210, 209]
def amber(phase): return fg(AMBER[int(phase * len(AMBER)) % len(AMBER)])

SPINNER  = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
SPARK    = "▁▂▃▄▅▆▇█"
PARTIALS = "▏▎▍▌▋▊▉"

GRAD = [
    (255, 176,  58),
    (255, 108, 158),
    (167, 108, 255),
    ( 82, 196, 255),
    (108, 255, 176),
    (255, 176,  58),
]

def grad_color(t):
    t = t % 1.0
    n = len(GRAD) - 1
    seg = t * n
    i = int(seg); f = seg - i
    a = GRAD[i]; b = GRAD[i + 1]
    return (int(a[0]+(b[0]-a[0])*f),
            int(a[1]+(b[1]-a[1])*f),
            int(a[2]+(b[2]-a[2])*f))

ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
def vlen(s): return len(ANSI_RE.sub("", s))
def pad_to(s, w):
    g = w - vlen(s)
    return s + (" " * g if g > 0 else "")

LOGOS = {
    "kali": r"""
      ,;:ccc,.
    .';;;:::;,,.x,
 ..'''.            0Xxoc:,.
.                ,ONkc;,;cokOdc',
                dMc               :OO;
                0M.                 .:o.
                ;Wd
                 ;XO,
                   ,d0Odlc;,..
                       ..,;:cdOOd::,.
                                .:d;.':;.
                                   'd,  .'
                                     ;l   ..
                                      .o
""",
}

# ---------- io ----------
def read_file(path, default=""):
    try:
        with open(path) as f: return f.read().strip()
    except Exception: return default

def run(cmd, timeout=0.6):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL,
                                       timeout=timeout).decode(errors="replace").strip()
    except Exception: return ""

def human_bytes(n):
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024: return f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} TB"

# ---------- collectors ----------
def distro():
    d = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            d[k] = v.strip().strip('"')
    return f"{d.get('NAME','Linux')} {d.get('VERSION_ID') or d.get('VERSION','')}".strip()

def uptime_str(secs=None):
    if secs is None:
        try: secs = float(read_file("/proc/uptime").split()[0])
        except: secs = 0.0
    dd = int(secs//86400); h = int((secs%86400)//3600)
    m = int((secs%3600)//60); s = int(secs%60)
    parts = []
    if dd: parts.append(f"{dd}d")
    if h: parts.append(f"{h}h")
    if m: parts.append(f"{m}m")
    parts.append(f"{s}s")
    return " ".join(parts)

def shell():
    name = os.path.basename(os.environ.get("SHELL", "")) or "sh"
    if "zsh" in name:
        return f"zsh {os.environ.get('ZSH_VERSION','')}".strip()
    if "bash" in name:
        return f"bash {os.environ.get('BASH_VERSION','').split('.')[0]}".strip()
    return name

def wm():
    sess = os.environ.get("XDG_SESSION_TYPE", "").lower()
    de = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION","")
    return f"{de} ({sess})" if de and sess else (de or "unknown")

def cpu_model():
    info = read_file("/proc/cpuinfo")
    model = ""; count = 0
    for line in info.splitlines():
        if line.startswith("processor"): count += 1
        elif line.startswith("model name") and not model:
            model = line.split(":", 1)[1].strip()
    count = count or os.cpu_count() or 1
    model = re.sub(r"\s+CPU\s+", " ", model)
    model = re.sub(r"\s+", " ", model).strip()
    return f"{model} ({count}c)" if model else f"{count}-core"

def ram_stats():
    info = read_file("/proc/meminfo")
    total = avail = 0
    for line in info.splitlines():
        if line.startswith("MemTotal:"): total = int(line.split()[1])
        elif line.startswith("MemAvailable:"): avail = int(line.split()[1])
    used = total - avail if total else 0
    return used, total, (used/total if total else 0)

def disk_stats(path="/"):
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used = total - free
        return used, total, (used/total if total else 0)
    except Exception:
        return 0, 0, 0

def load_avg():
    try: return read_file("/proc/loadavg").split()[:3]
    except: return ["0.00","0.00","0.00"]

def proc_count():
    try: return len([p for p in os.listdir("/proc") if p.isdigit()])
    except: return 0

def net_bytes():
    rx = tx = 0
    try:
        for line in read_file("/proc/net/dev").splitlines()[2:]:
            if ":" not in line: continue
            iface, data = line.split(":", 1)
            if iface.strip() == "lo": continue
            p = data.split()
            rx += int(p[0]); tx += int(p[8])
    except: pass
    return rx, tx

def gpu():
    for line in run(["lspci"], timeout=0.8).splitlines():
        if "VGA" in line or "3D controller" in line:
            return line.split(": ", 1)[-1]
    return ""

def read_cpu_times():
    parts = [int(x) for x in read_file("/proc/stat").splitlines()[0].split()[1:]]
    idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
    return idle, sum(parts)

def cpu_percent(prev, cur):
    didle = cur[0] - prev[0]; dtotal = cur[1] - prev[1]
    if dtotal <= 0: return 0.0
    return max(0.0, min(100.0, 100.0 * (1 - didle/dtotal)))

def sparkline(vals, w=12):
    if not vals: return ""
    return "".join(SPARK[min(len(SPARK)-1, int(v/100*len(SPARK)))]
                   for v in vals[-w:])

def bar(pct, w=12):
    pct = max(0.0, min(1.0, pct))
    eighths = int(pct * w * 8)
    full = eighths // 8
    partial = eighths % 8
    filled = "█" * full
    if partial and full < w:
        filled += PARTIALS[partial - 1]
        full += 1
    empty = w - full
    c = fg(120) if pct < 0.5 else (fg(214) if pct < 0.75 else fg(202))
    return f"{c}{filled}{fg(238)}{'░'*empty}{RESET}"

def gradient_logo(logo_lines, phase, mouse_phase):
    out = []
    for i, line in enumerate(logo_lines):
        row_t = (i / max(1, len(logo_lines)) + phase + mouse_phase) % 1.0
        colored = []
        for j, ch in enumerate(line):
            if ch == " ":
                colored.append(ch); continue
            t = row_t + (j / max(1, len(line))) * 0.4
            r, g, b = grad_color(t)
            colored.append(f"{rgb(r,g,b)}{ch}")
        colored.append(RESET)
        out.append("".join(colored))
    return out

# ---------- cava ----------
CAVA_CONF = "/tmp/termfetch-cava.conf"

def write_cava_conf(bars=14):
    with open(CAVA_CONF, "w") as f:
        f.write(f"""[general]
framerate = 60
bars = {bars}

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = mono
""")

def start_cava(bars=14):
    if not shutil.which("cava"): return None
    write_cava_conf(bars)
    try:
        return subprocess.Popen(["cava", "-p", CAVA_CONF],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                bufsize=0)
    except Exception:
        return None

def cava_reader(proc, q, stop):
    try:
        while not stop.is_set():
            line = proc.stdout.readline()
            if not line: break
            try:
                s = line.decode(errors="replace").strip().rstrip(";")
                vals = [int(x) for x in s.split(";") if x.strip()]
                if vals:
                    while not q.empty():
                        try: q.get_nowait()
                        except queue.Empty: break
                    q.put(vals)
            except Exception: pass
    except Exception: pass

def render_cava(vals, height, phase, mouse_phase):
    if not vals or height < 2:
        return ["" for _ in range(height)]
    n = len(vals)
    rows = [[" "] * (n * 2) for _ in range(height)]
    for b, v in enumerate(vals):
        eighths = int((v / 100.0) * (height * 8))
        full_cells = eighths // 8
        rem = eighths % 8
        for r in range(height):
            fb = height - 1 - r
            if fb < full_cells: ch = "█"
            elif fb == full_cells and rem: ch = PARTIALS[rem - 1]
            else: continue
            hue = (b/max(1,n) + phase*0.5 + mouse_phase) % 1.0
            t = int(hue * len(GRAD)) % len(GRAD)
            r0, g0, b0 = GRAD[t]
            col = rgb(r0, g0, b0)
            rows[r][b*2]   = f"{col}{ch}{RESET}"
            rows[r][b*2+1] = f"{col}{ch}{RESET}"
    return ["".join(row) for row in rows]

# ---------- info lines ----------
def kv(key, value):
    return f"{fg(208)}{key:<8}{RESET}{value}"

def build_info(stats):
    user = os.environ.get("USER", "user")
    host = platform.node() or "host"
    spin = SPINNER[stats["frame"] % len(SPINNER)]
    lines = [
        f"{fg(208)}{user}@{host}{RESET}  {fg(208)}{spin}{RESET}",
        "─" * 44,
        kv("OS",     stats["distro"]),
        kv("Kernel", stats["kernel"]),
        kv("Uptime", stats["uptime"]),
        kv("Load",   "  ".join(stats["load"])),
        kv("Shell",  stats["shell"]),
        kv("WM",     stats["wm"]),
        kv("CPU",    f"{stats['cpu']:5.1f}%  {bar(stats['cpu']/100, 12)}  {sparkline(stats['cpu_history'], 12)}"),
        kv("RAM",    f"{stats['ram_used']/1024/1024:>4.1f}/{stats['ram_total']/1024/1024:.1f}G  {bar(stats['ram_pct'], 12)}"),
        kv("Disk",   f"{stats['disk_used']/1024**3:>3.0f}/{stats['disk_total']/1024**3:.0f}G  {bar(stats['disk_pct'], 12)}"),
        kv("Net",    f"▼ {stats['rx_rate']}   ▲ {stats['tx_rate']}"),
        kv("Procs",  str(stats["proc_count"])),
    ]
    if stats.get("gpu"):
        lines.append(kv("GPU", stats["gpu"][:50]))
    lines.append("")
    lines.append(f"{fg(208)}q{RESET} quit   {fg(208)}space{RESET} pause")
    return lines

# ---------- live loop ----------
def run_live():
    fd = sys.stdin.fileno()
    old_term = termios.tcgetattr(fd)
    paused = False
    frame = 0
    prev_cpu = None
    prev_net = None
    cpu_history = []
    stats = None
    last_sample = 0.0

    cava_proc = start_cava(bars=14)
    cava_q = queue.Queue(maxsize=2)
    cava_stop = threading.Event()
    cava_bars = []
    if cava_proc and cava_proc.stdout:
        threading.Thread(target=cava_reader,
                         args=(cava_proc, cava_q, cava_stop),
                         daemon=True).start()

    def cleanup():
        cava_stop.set()
        try:
            if cava_proc: cava_proc.terminate()
        except Exception: pass
        try:
            sys.stdout.write(RESET + SHOW_CURSOR + ALT_OFF + "\n")
            sys.stdout.flush()
        except Exception: pass
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
        except Exception: pass

    atexit.register(cleanup)

    try:
        # raw mode
        nt = termios.tcgetattr(fd)
        nt[0] &= ~(termios.BRKINT | termios.ICRNL | termios.INPCK
                   | termios.ISTRIP | termios.IXON)
        nt[1] &= ~termios.OPOST
        nt[2] |= termios.CS8
        nt[3] &= ~(termios.ECHO | termios.ICANON | termios.IEXTEN | termios.ISIG)
        nt[6][termios.VMIN] = 1
        nt[6][termios.VTIME] = 0
        termios.tcsetattr(fd, termios.TCSANOW, nt)

        # enter alt screen and clear
        sys.stdout.write(ALT_ON + HOME + CLEAR + HIDE_CURSOR)
        sys.stdout.flush()

        while True:
            r, _, _ = select.select([fd], [], [], 0.04)
            if r:
                try: data = os.read(fd, 32)
                except Exception: data = b""
                for b in data:
                    if b in (ord('q'), ord('Q'), 3):
                        raise KeyboardInterrupt
                    if b == 32:
                        paused = not paused

            if not paused:
                frame += 1

            now = time.time()
            if stats is None or (not paused and now - last_sample >= 0.5):
                idle, total = read_cpu_times()
                pct = cpu_percent(prev_cpu, (idle, total)) if prev_cpu else 0.0
                prev_cpu = (idle, total)
                cpu_history.append(pct)
                cpu_history = cpu_history[-40:]

                rx, tx = net_bytes()
                if prev_net and prev_net[2] > 0:
                    dt = now - prev_net[2]
                    rx_rate = human_bytes(max(0, (rx - prev_net[0]) / dt)) + "/s"
                    tx_rate = human_bytes(max(0, (tx - prev_net[1]) / dt)) + "/s"
                else:
                    rx_rate = tx_rate = "—"
                prev_net = (rx, tx, now)

                used, rtotal, rpct = ram_stats()
                dused, dtotal, dpct = disk_stats()

                stats = {
                    "distro": distro(), "kernel": platform.release(),
                    "uptime": uptime_str(), "load": load_avg(),
                    "shell": shell(), "wm": wm(),
                    "cpu": pct, "cpu_history": cpu_history,
                    "ram_used": used, "ram_total": rtotal, "ram_pct": rpct,
                    "disk_used": dused, "disk_total": dtotal, "disk_pct": dpct,
                    "rx_rate": rx_rate, "tx_rate": tx_rate,
                    "proc_count": proc_count(), "gpu": gpu(),
                    "frame": 0,
                }
                last_sample = now

            if stats is None:
                continue
            stats["frame"] = frame
            stats["uptime"] = uptime_str()

            try:
                while True:
                    cava_bars = cava_q.get_nowait()
            except queue.Empty:
                pass

            logo_lines = LOGOS["kali"].strip("\n").splitlines()
            colored_logo = gradient_logo(logo_lines,
                                         phase=(frame * 0.02) % 1.0,
                                         mouse_phase=0.0)
            info = build_info(stats)

            cols = shutil.get_terminal_size((120, 40)).columns
            max_logo_w = max(vlen(l) for l in colored_logo)
            info_w = max(vlen(l) for l in info)

            cava_avail = cols - max_logo_w - info_w - 10
            if cava_bars and cava_avail >= 12:
                bars_n = min(len(cava_bars), max(6, cava_avail // 2))
                cava_lines = render_cava(cava_bars[:bars_n], height=len(info),
                                         phase=frame * 0.02, mouse_phase=0.0)
            else:
                cava_lines = ["" for _ in info]

            # --- adaptive layout ---
            if cols < 100:
                # narrow: no logo, just info — fits every time
                lines = list(info)
            else:
                n = max(len(colored_logo), len(info))
                lines = []
                for i in range(n):
                    left  = colored_logo[i] if i < len(colored_logo) else ""
                    right = info[i]         if i < len(info)         else ""
                    cav   = cava_lines[i]   if i < len(cava_lines)   else ""
                    pad = " " * (max_logo_w - vlen(left) + 4)
                    right_pad = pad_to(right, info_w)
                    lines.append(f"{left}{pad}{right_pad}  {cav}")

            body = "\n".join(lines)
            sys.stdout.write(HOME + CLEAR + body)
            sys.stdout.flush()

    except KeyboardInterrupt:
        pass
    finally:
        cleanup()
    return 0

# ---------- static ----------
def render_static():
    used, total, rpct = ram_stats()
    dused, dtotal, dpct = disk_stats()
    stats = {
        "distro": distro(), "kernel": platform.release(),
        "uptime": uptime_str(), "load": load_avg(),
        "shell": shell(), "wm": wm(),
        "cpu": 0.0, "cpu_history": [],
        "ram_used": used, "ram_total": total, "ram_pct": rpct,
        "disk_used": dused, "disk_total": dtotal, "disk_pct": dpct,
        "rx_rate": "—", "tx_rate": "—",
        "proc_count": proc_count(), "gpu": gpu(),
        "frame": 0,
    }
    logo_lines = LOGOS["kali"].strip("\n").splitlines()
    colored = gradient_logo(logo_lines, 0.0, 0.0)
    info = build_info(stats)
    max_w = max(vlen(l) for l in colored)
    n = max(len(colored), len(info))
    out = []
    for i in range(n):
        left  = colored[i] if i < len(colored) else ""
        right = info[i]    if i < len(info)    else ""
        pad = " " * (max_w - vlen(left) + 4)
        out.append(f"{left}{pad}{right}")
    return "\n".join(out)

def as_json():
    used, rtotal, _ = ram_stats()
    dused, dtotal, _ = disk_stats()
    rx, tx = net_bytes()
    return json.dumps({
        "user": os.environ.get("USER"), "host": platform.node(),
        "os": distro(), "kernel": platform.release(),
        "uptime": uptime_str(), "shell": shell(), "wm": wm(),
        "cpu": cpu_model(),
        "ram_used_mb": round(used/1024), "ram_total_mb": round(rtotal/1024),
        "disk_used_gb": round(dused/1024**3, 1),
        "disk_total_gb": round(dtotal/1024**3, 1),
        "gpu": gpu(), "procs": proc_count(),
    }, indent=2)

# ---------- CLI ----------
HELP = """termfetch — live system info

Usage: termfetch [OPTIONS]

  -s, --static    one-shot output (no animation)
  -n, --no-color  disable colors
      --json      print JSON
  -V, --version   show version
  -h, --help      show help

Live keys: q quit, space pause
"""

def parse_args(argv):
    opts = {"color": sys.stdout.isatty(), "json": False, "static": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if   a in ("--no-color","-n"): opts["color"] = False
        elif a in ("--static","-s"):   opts["static"] = True
        elif a == "--json":            opts["json"] = True
        elif a in ("--version","-V"):
            print(f"termfetch {VERSION}"); sys.exit(0)
        elif a in ("--help","-h"):
            print(HELP); sys.exit(0)
        i += 1
    return opts

def main(argv):
    opts = parse_args(argv)
    if opts["json"]:
        print(as_json()); return 0
    if not opts["color"]:
        g = globals()
        g["fg"] = lambda n: ""
        g["rgb"] = lambda r, gg, b: ""
    print(render_static())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
