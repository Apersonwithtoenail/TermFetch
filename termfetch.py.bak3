#!/usr/bin/env python3
"""termfetch — live animated system info for Linux. No dependencies.

Usage:
  termfetch              # animated live dashboard (mouse-reactive, cava)
  termfetch --static     # classic one-shot fetch
  termfetch --json       # machine-readable dump
"""

import os
import re
import sys
import json
import time
import queue
import select
import shutil
import platform
import threading
import subprocess
import termios
import tty
import atexit

VERSION = "0.3.0"

# ---------- ANSI ----------
ESC = "\033["
CLEAR = ESC + "2J"
HOME = ESC + "H"
HIDE_CURSOR = ESC + "?25l"
SHOW_CURSOR = ESC + "?25h"
ALT_ON = ESC + "?1049h"
ALT_OFF = ESC + "?1049l"
RESET = "\033[0m"
MOUSE_ON = ESC + "?1003h" + ESC + "?1006h"
MOUSE_OFF = ESC + "?1003l" + ESC + "?1006l"

def fg(n):
    return f"{ESC}38;5;{n}m"

AMBER = [208, 209, 210, 214, 215, 220, 221, 222, 220, 215, 210, 209]

def amber(phase):
    return fg(AMBER[int(phase * len(AMBER)) % len(AMBER)])

SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
SPARK = "▁▂▃▄▅▆▇█"
PARTIALS = "▏▎▍▌▋▊▉"

LOGOS = {
    "kali": r"""
      ,;:ccc,.
    .';;;:::;,,.x,
 ..'''.            0Xxoc:,.
.                ,ONkc;,;cokOdc',
                dMc               :OO;
                0M.                 .:o.
                ;Wd
                 ;XO,
                   ,d0Odlc;,..
                       ..,;:cdOOd::,.
                                .:d;.':;.
                                   'd,  .'
                                     ;l   ..
                                      .o
""",
}

# ---------- io helpers ----------
def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return default

def run(cmd, timeout=0.6):
    try:
        return subprocess.check_output(
            cmd, stderr=subprocess.DEVNULL, timeout=timeout,
        ).decode(errors="replace").strip()
    except Exception:
        return ""

# ---------- pretty bar ----------
def colored_bar(pct, width=18):
    pct = max(0.0, min(1.0, pct))
    total_eighths = int(pct * width * 8)
    full = total_eighths // 8
    partial = total_eighths % 8
    filled = "█" * full
    if partial and full < width:
        filled += PARTIALS[partial - 1]
        full += 1
    empty = width - full

    if pct < 0.5:
        c = fg(120)      # green
    elif pct < 0.75:
        c = fg(214)      # amber
    else:
        c = fg(202)      # red-orange

    return f"{c}{filled}{RESET}{fg(238)}{'░' * empty}{RESET}"

def sparkline(values, width=24):
    if not values:
        return ""
    vals = values[-width:]
    return "".join(SPARK[min(len(SPARK) - 1, int(v / 100 * len(SPARK)))]
                   for v in vals)

def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"

# ---------- collectors ----------
def distro():
    data = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            data[k] = v.strip().strip('"')
    return f"{data.get('NAME', 'Linux')} {data.get('VERSION_ID') or data.get('VERSION', '')}".strip()

def uptime_secs():
    try:
        return float(read_file("/proc/uptime").split()[0])
    except Exception:
        return 0.0

def uptime_str(secs=None):
    if secs is None:
        secs = uptime_secs()
    d = int(secs // 86400); h = int((secs % 86400) // 3600)
    m = int((secs % 3600) // 60); s = int(secs % 60)
    parts = []
    if d: parts.append(f"{d}d")
    if h: parts.append(f"{h}h")
    if m: parts.append(f"{m}m")
    parts.append(f"{s}s")
    return " ".join(parts)

def shell():
    name = os.path.basename(os.environ.get("SHELL", "")) or "sh"
    ver = ""
    if "zsh" in name:
        ver = os.environ.get("ZSH_VERSION", "")
    elif "bash" in name:
        ver = os.environ.get("BASH_VERSION", "").split(".")[0]
    return f"{name} {ver}".strip()

def wm():
    sess = os.environ.get("XDG_SESSION_TYPE", "").lower()
    de = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION", "")
    if de and sess:
        return f"{de} ({sess})"
    return de or "unknown"

def cpu_model():
    info = read_file("/proc/cpuinfo")
    model = ""; count = 0
    for line in info.splitlines():
        if line.startswith("processor"): count += 1
        elif line.startswith("model name") and not model:
            model = line.split(":", 1)[1].strip()
    count = count or os.cpu_count() or 1
    model = re.sub(r"\s+CPU\s+", " ", model)
    model = re.sub(r"\s+", " ", model).strip()
    return f"{model} ({count}c)" if model else f"{count}-core CPU"

def ram_stats():
    info = read_file("/proc/meminfo")
    total = avail = 0
    for line in info.splitlines():
        if line.startswith("MemTotal:"): total = int(line.split()[1])
        elif line.startswith("MemAvailable:"): avail = int(line.split()[1])
    used = total - avail if total else 0
    return used, total, (used / total if total else 0)

def disk_stats(path="/"):
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used = total - free
        return used, total, (used / total if total else 0)
    except Exception:
        return 0, 0, 0

def load_avg():
    try:
        return read_file("/proc/loadavg").split()[:3]
    except Exception:
        return ["0.00", "0.00", "0.00"]

def proc_count():
    try:
        return len([p for p in os.listdir("/proc") if p.isdigit()])
    except Exception:
        return 0

def net_bytes():
    rx = tx = 0
    try:
        for line in read_file("/proc/net/dev").splitlines()[2:]:
            if ":" not in line: continue
            iface, data = line.split(":", 1)
            if iface.strip() == "lo": continue
            p = data.split()
            rx += int(p[0]); tx += int(p[8])
    except Exception:
        pass
    return rx, tx

def gpu():
    for line in run(["lspci"], timeout=0.8).splitlines():
        if "VGA" in line or "3D controller" in line:
            return line.split(": ", 1)[-1]
    return ""

def resolution():
    if not shutil.which("xrandr"):
        return ""
    for line in run(["xrandr"], timeout=0.5).splitlines():
        m = re.search(r"(\d+)x(\d+)\+.*\*", line)
        if m:
            return f"{m.group(1)}x{m.group(2)}"
    return ""

def detect_logo():
    return "kali"

def read_cpu_times():
    parts = [int(x) for x in read_file("/proc/stat").splitlines()[0].split()[1:]]
    idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
    return idle, sum(parts)

def cpu_percent(prev, cur):
    didle = cur[0] - prev[0]
    dtotal = cur[1] - prev[1]
    if dtotal <= 0: return 0.0
    return max(0.0, min(100.0, 100.0 * (1 - didle / dtotal)))

# ---------- cava subprocess ----------
CAVA_CONF = "/tmp/termfetch-cava.conf"

def write_cava_conf(bars=16):
    with open(CAVA_CONF, "w") as f:
        f.write(f"""[general]
framerate = 60
bars = {bars}

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = mono
""")

def start_cava(bars=16):
    if not shutil.which("cava"):
        return None
    write_cava_conf(bars)
    try:
        proc = subprocess.Popen(
            ["cava", "-p", CAVA_CONF],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
        )
        return proc
    except Exception:
        return None

def cava_reader(proc, q, stop):
    try:
        while not stop.is_set():
            line = proc.stdout.readline()
            if not line:
                break
            try:
                s = line.decode(errors="replace").strip().rstrip(";")
                vals = [int(x) for x in s.split(";") if x.strip()]
                if vals:
                    while not q.empty():
                        try: q.get_nowait()
                        except queue.Empty: break
                    q.put(vals)
            except Exception:
                pass
    except Exception:
        pass

# ---------- render ----------
def kv(opts, key, value):
    return f"{opts['accent']}{key:<8}{opts['reset']}{value}"

def render_cava_vertical(vals, height, phase, mouse_phase):
    if not vals or height < 3:
        return ["" for _ in range(max(1, height))]
    n = len(vals)
    rows = [[" "] * (n * 2) for _ in range(height)]
    for b, v in enumerate(vals):
        level = (v / 100.0) * (height * 8)
        full_eighths = int(level)
        full_cells = full_eighths // 8
        remainder = full_eighths % 8
        for r in range(height):
            from_bottom = height - 1 - r
            if from_bottom < full_cells:
                ch = "█"
            elif from_bottom == full_cells and remainder:
                ch = PARTIALS[remainder - 1]
            else:
                continue
            hue = (b / max(1, n) + phase * 0.5 + mouse_phase) % 1.0
            col = amber(hue)
            rows[r][b * 2] = f"{col}{ch}{RESET}"
            rows[r][b * 2 + 1] = f"{col}{ch}{RESET}"
    return ["".join(row) for row in rows]

def build_info_lines(opts, stats):
    a = opts["accent"]; r = opts["reset"]
    user = os.environ.get("USER", "user")
    host = platform.node() or "host"
    spin = SPINNER[stats["frame"] % len(SPINNER)]
    lines = [
        f"{a}{user}@{host}{r}  {a}{spin}{r}",
        "─" * 40,
        kv(opts, "OS", stats["distro"]),
        kv(opts, "Kernel", stats["kernel"]),
        kv(opts, "Uptime", stats["uptime"]),
        kv(opts, "Load", "  ".join(stats["load"])),
        kv(opts, "Shell", stats["shell"]),
        kv(opts, "WM", stats["wm"]),
        kv(opts, "CPU", f"{stats['cpu']:5.1f}%  {colored_bar(stats['cpu']/100, 12)}  {sparkline(stats['cpu_history'], 16)}"),
        kv(opts, "RAM", f"{stats['ram_used']/1024/1024:.1f}/{stats['ram_total']/1024/1024:.1f}G  {colored_bar(stats['ram_pct'], 16)}"),
        kv(opts, "Disk", f"{stats['disk_used']/1024**3:.0f}/{stats['disk_total']/1024**3:.0f}G  {colored_bar(stats['disk_pct'], 16)}"),
        kv(opts, "Net", f"▼ {stats['rx_rate']}   ▲ {stats['tx_rate']}"),
        kv(opts, "Procs", str(stats["proc_count"])),
    ]
    if stats["gpu"]:
        lines.append(kv(opts, "GPU", stats["gpu"][:60]))
    lines.append("")
    lines.append(f"{a}q{r} quit   {a}space{r} pause   {a}mouse{r} to shift color")
    return lines

def compose(logo_lines, info_lines, cava_lines, opts, phase, mouse_phase):
    max_logo = max((len(l) for l in logo_lines), default=0)
    n = max(len(logo_lines), len(info_lines), len(cava_lines))
    out = []
    for i in range(n):
        left = logo_lines[i] if i < len(logo_lines) else ""
        right = info_lines[i] if i < len(info_lines) else ""
        cav = cava_lines[i] if i < len(cava_lines) else ""
        pad = " " * (max_logo - len(left) + 4)
        row_phase = (i / max(1, len(logo_lines)) + phase + mouse_phase) % 1.0
        col = amber(row_phase)
        out.append(f"{col}{left}{RESET}{pad}{right}  {cav}")
    return "\n".join(out)

# ---------- input parsing ----------
def parse_input(data, state):
    state["buf"] += data
    keys = []
    mouse = None
    while state["buf"]:
        b = state["buf"]
        if b[0:1] == b"\x1b":
            if b.startswith(b"\x1b[<"):
                end_m = b.find(b"M")
                end_m_low = b.find(b"m")
                candidates = [x for x in (end_m, end_m_low) if x != -1]
                if not candidates:
                    break
                end = min(candidates)
                seq = b[3:end].decode(errors="replace")
                try:
                    btn, x, y = seq.split(";")
                    mouse = (int(x), int(y))
                except Exception:
                    pass
                state["buf"] = b[end + 1:]
            elif b.startswith(b"\x1b[") and len(b) < 3:
                break
            elif b.startswith(b"\x1b["):
                # skip known CSI like arrow keys (3 bytes usually)
                # find final byte in range 0x40-0x7E
                j = 2
                while j < len(b) and not (0x40 <= b[j] <= 0x7E):
                    j += 1
                if j >= len(b):
                    break
                state["buf"] = b[j + 1:]
            else:
                # bare ESC — treat as key
                keys.append("\x1b")
                state["buf"] = b[1:]
        else:
            try:
                ch = b[0:1].decode("utf-8", errors="ignore")
                keys.append(ch)
            except Exception:
                pass
            state["buf"] = b[1:]
    return keys, mouse

# ---------- live loop ----------
def run_live(opts):
    fd = sys.stdin.fileno()
    tty_state = termios.tcgetattr(fd)
    paused = False
    frame = 0
    prev_cpu = None
    prev_net = None
    cpu_history = []
    stats = None
    last_sample = 0.0
    mouse_x = 0.0        # 0..1 normalized
    mouse_target = 0.0

    cava_proc = start_cava(bars=16)
    cava_q = queue.Queue(maxsize=2)
    cava_stop = threading.Event()
    cava_bars = []
    if cava_proc and cava_proc.stdout:
        t = threading.Thread(target=cava_reader,
                             args=(cava_proc, cava_q, cava_stop),
                             daemon=True)
        t.start()

    def cleanup():
        cava_stop.set()
        try:
            if cava_proc: cava_proc.terminate()
        except Exception:
            pass
        try:
            sys.stdout.write(RESET + SHOW_CURSOR + MOUSE_OFF + ALT_OFF)
            sys.stdout.flush()
        except Exception:
            pass
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, tty_state)
        except Exception:
            pass

    atexit.register(cleanup)
    input_state = {"buf": b""}

    try:
        tty.setcbreak(fd)
        sys.stdout.write(ALT_ON + HIDE_CURSOR + MOUSE_ON)
        sys.stdout.flush()

        while True:
            # input
            r, _, _ = select.select([sys.stdin], [], [], 0.033)
            if r:
                try:
                    data = os.read(fd, 256)
                except Exception:
                    data = b""
                keys, mouse = parse_input(data, input_state)
                for k in keys:
                    if k in ("q", "Q", "\x03"):
                        raise KeyboardInterrupt
                    if k == " ":
                        paused = not paused
                if mouse is not None:
                    cols = shutil.get_terminal_size((100, 40)).columns
                    mouse_target = max(0.0, min(1.0, mouse[0] / max(1, cols)))

            if not paused:
                frame += 1

            # ease mouse phase toward target
            mouse_x += (mouse_target - mouse_x) * 0.15

            now = time.time()
            if stats is None or (not paused and now - last_sample >= 0.5):
                idle, total = read_cpu_times()
                pct = cpu_percent(prev_cpu, (idle, total)) if prev_cpu else 0.0
                prev_cpu = (idle, total)
                cpu_history.append(pct)
                cpu_history = cpu_history[-40:]

                rx, tx = net_bytes()
                if prev_net and prev_net[2] > 0:
                    dt = now - prev_net[2]
                    rx_rate = human_bytes(max(0, (rx - prev_net[0]) / dt)) + "/s"
                    tx_rate = human_bytes(max(0, (tx - prev_net[1]) / dt)) + "/s"
                else:
                    rx_rate = tx_rate = "—"
                prev_net = (rx, tx, now)

                used, rtotal, rpct = ram_stats()
                dused, dtotal, dpct = disk_stats()

                stats = {
                    "distro": distro(),
                    "kernel": platform.release(),
                    "uptime": uptime_str(),
                    "load": load_avg(),
                    "shell": shell(),
                    "wm": wm(),
                    "cpu": pct,
                    "cpu_history": cpu_history,
                    "ram_used": used, "ram_total": rtotal, "ram_pct": rpct,
                    "disk_used": dused, "disk_total": dtotal, "disk_pct": dpct,
                    "rx_rate": rx_rate, "tx_rate": tx_rate,
                    "proc_count": proc_count(),
                    "gpu": gpu(),
                    "frame": 0,
                }
                last_sample = now

            if stats is None:
                continue
            stats["frame"] = frame
            stats["uptime"] = uptime_str()

            # drain cava queue
            try:
                while True:
                    cava_bars = cava_q.get_nowait()
            except queue.Empty:
                pass

            logo_lines = LOGOS.get(opts["logo"] or detect_logo(),
                                   LOGOS["kali"]).strip("\n").splitlines()
            info = [""] + build_info_lines(opts, stats)

            cols = shutil.get_terminal_size((100, 40)).columns
            max_logo = max(len(l) for l in logo_lines)
            info_w = max(len(re.sub(r"\x1b\[[0-9;]*m", "", l)) for l in info)
            cava_w_needed = 8 * 2  # minimum 8 bars
            remaining = cols - (max_logo + 4 + info_w + 4)

            if cava_bars and remaining >= cava_w_needed:
                bars_to_show = min(len(cava_bars), max(8, remaining // 2))
                vals = cava_bars[:bars_to_show]
                cava_lines = render_cava_vertical(
                    vals, height=len(info),
                    phase=frame * 0.02,
                    mouse_phase=mouse_x,
                )
            else:
                cava_lines = ["" for _ in range(len(info))]

            body = compose(logo_lines, info, cava_lines, opts,
                           phase=(frame * 0.03) % 1.0,
                           mouse_phase=mouse_x * 0.5)

            sys.stdout.write(HOME + CLEAR + body)
            sys.stdout.flush()

    except KeyboardInterrupt:
        pass
    finally:
        cleanup()
    return 0

# ---------- static & json ----------
def render_static(opts):
    a = opts["accent"]; r = opts["reset"]
    user = os.environ.get("USER", "user")
    host = platform.node() or "host"
    used, total, rpct = ram_stats()
    dused, dtotal, dpct = disk_stats()
    lines = [
        "",
        f"{a}{user}@{host}{r}",
        "─" * 30,
        kv(opts, "OS", distro()),
        kv(opts, "Kernel", platform.release()),
        kv(opts, "Uptime", uptime_str()),
        kv(opts, "Shell", shell()),
        kv(opts, "WM", wm()),
        kv(opts, "CPU", cpu_model()),
        kv(opts, "RAM", f"{used/1024/1024:.1f} / {total/1024/1024:.1f} GB  {colored_bar(rpct, 12)}"),
        kv(opts, "Disk", f"/  {dused/1024**3:.0f} / {dtotal/1024**3:.0f} GB  {colored_bar(dpct, 12)}"),
    ]
    g = gpu()
    if g: lines.append(kv(opts, "GPU", g))
    d = resolution()
    if d: lines.append(kv(opts, "Display", d))
    logo_lines = LOGOS.get(opts["logo"] or detect_logo(),
                           LOGOS["kali"]).strip("\n").splitlines()
    max_logo = max((len(l) for l in logo_lines), default=0)
    n = max(len(logo_lines), len(lines))
    out = []
    for i in range(n):
        left = logo_lines[i] if i < len(logo_lines) else ""
        right = lines[i] if i < len(lines) else ""
        pad = " " * (max_logo - len(left) + 4)
        out.append(f"{a}{left}{r}{pad}{right}")
    return "\n".join(out)

def as_json():
    used, rtotal, _ = ram_stats()
    dused, dtotal, _ = disk_stats()
    rx, tx = net_bytes()
    return json.dumps({
        "user": os.environ.get("USER"),
        "host": platform.node(),
        "os": distro(),
        "kernel": platform.release(),
        "uptime": uptime_str(),
        "shell": shell(),
        "wm": wm(),
        "cpu": cpu_model(),
        "ram_used_mb": round(used / 1024),
        "ram_total_mb": round(rtotal / 1024),
        "disk_used_gb": round(dused / 1024**3, 1),
        "disk_total_gb": round(dtotal / 1024**3, 1),
        "gpu": gpu(),
        "display": resolution(),
        "net_rx_bytes": rx,
        "net_tx_bytes": tx,
        "procs": proc_count(),
    }, indent=2)

# ---------- CLI ----------
HELP = """\
termfetch — live animated system info

Usage: termfetch [OPTIONS]

Options:
  -s, --static       one-shot output (no animation)
  -n, --no-color     disable colors
  -l, --logo NAME    pick a logo
      --json         print as JSON
  -V, --version      show version
  -h, --help         show this help

Live mode keys:
  q       quit
  space   pause
  mouse   shift amber hue
"""

def parse_args(argv):
    opts = {"color": sys.stdout.isatty(), "logo": None,
            "json": False, "static": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--no-color", "-n"):
            opts["color"] = False
        elif a in ("--static", "-s"):
            opts["static"] = True
        elif a == "--json":
            opts["json"] = True
        elif a in ("--logo", "-l") and i + 1 < len(argv):
            i += 1
            opts["logo"] = argv[i]
        elif a in ("--version", "-V"):
            print(f"termfetch {VERSION}")
            sys.exit(0)
        elif a in ("--help", "-h"):
            print(HELP)
            sys.exit(0)
        i += 1
    return opts

def main(argv):
    opts = parse_args(argv)

    if opts["json"]:
        print(as_json())
        return 0

    if not opts["color"]:
        opts["accent"] = ""
        opts["reset"] = ""
    else:
        opts["accent"] = fg(208)
        opts["reset"] = RESET

    if opts["static"] or not sys.stdout.isatty():
        print(render_static(opts))
        return 0

    return run_live(opts)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
