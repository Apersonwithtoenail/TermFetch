#!/usr/bin/env python3
"""termfetch — live animated system info for Linux. No dependencies.

Usage:
  termfetch              # animated live dashboard
  termfetch --static     # classic one-shot fetch
  termfetch --json       # machine-readable dump
"""

import os
import re
import sys
import json
import time
import select
import shutil
import signal
import platform
import subprocess
import termios
import tty
import atexit

VERSION = "0.2.0"

# ---------- ANSI ----------
ESC = "\033["
CLEAR = ESC + "2J"
HOME = ESC + "H"
HIDE_CURSOR = ESC + "?25l"
SHOW_CURSOR = ESC + "?25h"
ALT_ON = ESC + "?1049h"
ALT_OFF = ESC + "?1049l"
RESET = "\033[0m"

def fg(n):
    return f"{ESC}38;5;{n}m"

# Amber gradient stops (256-color)
AMBER = [208, 209, 210, 214, 215, 220, 221, 216, 215, 214, 210, 209]

def amber(phase):
    return fg(AMBER[int(phase * len(AMBER)) % len(AMBER)])

# Braille spinner
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

# Sparkline blocks
BLOCKS = "▁▂▃▄▅▆▇█"

# ---------- Logos ----------
LOGOS = {
    "kali": r"""
      ,;:ccc,.
    .';;;:::;,,.x,
 ..'''.            0Xxoc:,.
.                ,ONkc;,;cokOdc',
                dMc               :OO;
                0M.                 .:o.
                ;Wd
                 ;XO,
                   ,d0Odlc;,..
                       ..',;:cdOOd::,.
                                .:d;.':;.
                                   'd,  .'
                                     ;l   ..
                                      .o
""",
}

# ---------- helpers ----------
def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return default

def run(cmd, timeout=0.6):
    try:
        return subprocess.check_output(
            cmd, stderr=subprocess.DEVNULL, timeout=timeout,
        ).decode(errors="replace").strip()
    except Exception:
        return ""

def bar(pct, width=10):
    filled = max(0, min(width, int(round(pct * width))))
    return "▓" * filled + "░" * (width - filled)

def sparkline(values, width=24):
    if not values:
        return ""
    vals = values[-width:]
    return "".join(BLOCKS[min(len(BLOCKS) - 1, int(v / 100 * len(BLOCKS)))]
                   for v in vals)

# ---------- collectors ----------
def distro():
    data = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            data[k] = v.strip().strip('"')
    name = data.get("NAME", "Linux")
    ver = data.get("VERSION_ID") or data.get("VERSION", "")
    return f"{name} {ver}".strip()

def uptime_secs():
    try:
        return float(read_file("/proc/uptime").split()[0])
    except Exception:
        return 0.0

def uptime_str(secs=None):
    if secs is None:
        secs = uptime_secs()
    d = int(secs // 86400)
    h = int((secs % 86400) // 3600)
    m = int((secs % 3600) // 60)
    s = int(secs % 60)
    parts = []
    if d: parts.append(f"{d}d")
    if h: parts.append(f"{h}h")
    if m: parts.append(f"{m}m")
    parts.append(f"{s}s")
    return " ".join(parts)

def shell():
    sh = os.environ.get("SHELL", "")
    name = os.path.basename(sh) or "sh"
    ver = ""
    if "zsh" in name:
        ver = os.environ.get("ZSH_VERSION", "")
    elif "bash" in name:
        ver = os.environ.get("BASH_VERSION", "").split(".")[0]
    return f"{name} {ver}".strip()

def wm():
    sess = os.environ.get("XDG_SESSION_TYPE", "").lower()
    de = (os.environ.get("XDG_CURRENT_DESKTOP")
          or os.environ.get("DESKTOP_SESSION", ""))
    if de and sess:
        return f"{de} ({sess})"
    return de or "unknown"

def cpu_model():
    info = read_file("/proc/cpuinfo")
    model = ""
    count = 0
    for line in info.splitlines():
        if line.startswith("processor"):
            count += 1
        elif line.startswith("model name") and not model:
            model = line.split(":", 1)[1].strip()
    count = count or os.cpu_count() or 1
    model = re.sub(r"\s+CPU\s+", " ", model)
    model = re.sub(r"\s+", " ", model).strip()
    return f"{model} ({count}c)" if model else f"{count}-core CPU"

def ram_stats():
    info = read_file("/proc/meminfo")
    total = avail = 0
    for line in info.splitlines():
        if line.startswith("MemTotal:"):
            total = int(line.split()[1])
        elif line.startswith("MemAvailable:"):
            avail = int(line.split()[1])
    if not total:
        return 0, 0, 0
    used = total - avail
    return used, total, used / total

def disk_stats(path="/"):
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used = total - free
        return used, total, used / total if total else 0
    except Exception:
        return 0, 0, 0

def load_avg():
    try:
        return read_file("/proc/loadavg").split()[:3]
    except Exception:
        return ["0.00", "0.00", "0.00"]

def proc_count():
    try:
        return len([p for p in os.listdir("/proc") if p.isdigit()])
    except Exception:
        return 0

def net_bytes():
    """Return (rx, tx) bytes across all non-lo interfaces."""
    total_rx = total_tx = 0
    try:
        for line in read_file("/proc/net/dev").splitlines()[2:]:
            if ":" not in line:
                continue
            iface, data = line.split(":", 1)
            if iface.strip() == "lo":
                continue
            parts = data.split()
            total_rx += int(parts[0])
            total_tx += int(parts[8])
    except Exception:
        pass
    return total_rx, total_tx

def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"

def gpu():
    out = run(["lspci"], timeout=0.8)
    for line in out.splitlines():
        if "VGA" in line or "3D controller" in line:
            return line.split(": ", 1)[-1]
    return ""

def resolution():
    if not shutil.which("xrandr"):
        return ""
    out = run(["xrandr"], timeout=0.5)
    for line in out.splitlines():
        m = re.search(r"(\d+)x(\d+)\+.*\*", line)
        if m:
            return f"{m.group(1)}x{m.group(2)}"
    return ""

def detect_logo():
    data = read_file("/etc/os-release").lower()
    if "kali" in data:
        return "kali"
    return "kali"

# ---------- CPU sampler ----------
def read_cpu_times():
    parts = read_file("/proc/stat").splitlines()[0].split()[1:]
    parts = [int(x) for x in parts]
    idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
    total = sum(parts)
    return idle, total

def cpu_percent(prev, cur):
    didle = cur[0] - prev[0]
    dtotal = cur[1] - prev[1]
    if dtotal <= 0:
        return 0.0
    return max(0.0, min(100.0, 100.0 * (1 - didle / dtotal)))

# ---------- static render ----------
def kv(opts, key, value):
    a = opts["accent"]
    r = opts["reset"]
    return f"{a}{key:<9}{r}{value}"

def static_lines(opts):
    a = opts["accent"]
    r = opts["reset"]
    user = os.environ.get("USER", "user")
    host = platform.node() or "host"
    sep = "─" * 30
    used, total, rpct = ram_stats()
    dused, dtotal, dpct = disk_stats()
    out = [
        f"{a}{user}@{host}{r}",
        sep,
        kv(opts, "OS", distro()),
        kv(opts, "Kernel", platform.release()),
        kv(opts, "Uptime", uptime_str()),
        kv(opts, "Shell", shell()),
        kv(opts, "WM", wm()),
        kv(opts, "CPU", cpu_model()),
        kv(opts, "RAM", f"{used/1024/1024:.1f} / {total/1024/1024:.1f} GB  {bar(rpct)}"),
        kv(opts, "Disk", f"/  {dused/1024**3:.0f} / {dtotal/1024**3:.0f} GB  {bar(dpct)}"),
    ]
    g = gpu()
    if g:
        out.append(kv(opts, "GPU", g))
    d = resolution()
    if d:
        out.append(kv(opts, "Display", d))
    return out

def render_static(opts):
    logo = LOGOS.get(opts["logo"] or detect_logo(), LOGOS["kali"])
    logo_lines = logo.strip("\n").splitlines()
    info = [""] + static_lines(opts)
    return render_columns(logo_lines, info, opts, phase=None)

def render_columns(logo_lines, info_lines, opts, phase=None):
    a_off = opts["accent"]
    r = opts["reset"]
    max_logo = max((len(l) for l in logo_lines), default=0)
    n = max(len(logo_lines), len(info_lines))
    out = []
    for i in range(n):
        left = logo_lines[i] if i < len(logo_lines) else ""
        right = info_lines[i] if i < len(info_lines) else ""
        pad = " " * (max_logo - len(left) + 4)
        if phase is not None:
            col = amber((i / max(1, len(logo_lines)) + phase) % 1.0)
            left_col = f"{col}{left}{r}"
        else:
            left_col = f"{a_off}{left}{r}"
        out.append(f"{left_col}{pad}{right}")
    return "\n".join(out)

# ---------- live render ----------
def live_lines(opts, stats):
    a = opts["accent"]
    r = opts["reset"]
    user = os.environ.get("USER", "user")
    host = platform.node() or "host"
    sep = "─" * 40

    spin = SPINNER[stats["frame"] % len(SPINNER)]
    cpu_bar = bar(stats["cpu"] / 100.0)
    ram_bar = bar(stats["ram_pct"])
    disk_bar = bar(stats["disk_pct"])
    cpu_spark = sparkline(stats["cpu_history"])

    lines = [
        f"{a}{user}@{host}{r}  {a}{spin}{r}",
        sep,
        kv(opts, "OS", stats["distro"]),
        kv(opts, "Kernel", stats["kernel"]),
        kv(opts, "Uptime", stats["uptime"]),
        kv(opts, "Load", "  ".join(stats["load"])),
        kv(opts, "Shell", stats["shell"]),
        kv(opts, "WM", stats["wm"]),
        kv(opts, "CPU", f"{stats['cpu']:5.1f}%  {cpu_bar}  {cpu_spark}"),
        kv(opts, "RAM",
           f"{stats['ram_used']/1024/1024:.1f} / "
           f"{stats['ram_total']/1024/1024:.1f} GB  {ram_bar}"),
        kv(opts, "Disk",
           f"/  {stats['disk_used']/1024**3:.0f} / "
           f"{stats['disk_total']/1024**3:.0f} GB  {disk_bar}"),
        kv(opts, "Net", f"▼ {stats['rx_rate']}   ▲ {stats['tx_rate']}"),
        kv(opts, "Procs", str(stats["proc_count"])),
    ]
    if stats["gpu"]:
        lines.append(kv(opts, "GPU", stats["gpu"]))
    if stats["display"]:
        lines.append(kv(opts, "Display", stats["display"]))
    lines.append("")
    lines.append(f"{a}q{r} quit   {a}space{r} pause")
    return lines

def collect_stats(prev_cpu, prev_net, cpu_history):
    now = time.time()
    idle, total = read_cpu_times()
    pct = cpu_percent(prev_cpu, (idle, total)) if prev_cpu else 0.0
    cpu_history.append(pct)
    if len(cpu_history) > 40:
        cpu_history = cpu_history[-40:]

    rx, tx = net_bytes()
    if prev_net and prev_net[2] > 0:
        dt = now - prev_net[2]
        rx_rate = human_bytes(max(0, (rx - prev_net[0]) / dt)) + "/s"
        tx_rate = human_bytes(max(0, (tx - prev_net[1]) / dt)) + "/s"
    else:
        rx_rate = tx_rate = "—"

    used, rtotal, rpct = ram_stats()
    dused, dtotal, dpct = disk_stats()

    return {
        "distro": distro(),
        "kernel": platform.release(),
        "uptime": uptime_str(),
        "load": load_avg(),
        "shell": shell(),
        "wm": wm(),
        "cpu": pct,
        "cpu_history": cpu_history,
        "ram_used": used, "ram_total": rtotal, "ram_pct": rpct,
        "disk_used": dused, "disk_total": dtotal, "disk_pct": dpct,
        "rx_rate": rx_rate, "tx_rate": tx_rate,
        "proc_count": proc_count(),
        "gpu": gpu(),
        "display": resolution(),
        "frame": 0,
    }, (idle, total), (rx, tx, now)

def run_live(opts):
    fd = sys.stdin.fileno()
    tty_state = termios.tcgetattr(fd)
    paused = False
    frame = 0
    prev_cpu = None
    prev_net = None
    cpu_history = []
    stats = None
    last_sample = 0.0

    def cleanup():
        try:
            sys.stdout.write(RESET + SHOW_CURSOR + ALT_OFF)
            sys.stdout.flush()
        except Exception:
            pass
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, tty_state)
        except Exception:
            pass

    atexit.register(cleanup)

    try:
        tty.setcbreak(fd)
        sys.stdout.write(ALT_ON + HIDE_CURSOR)
        sys.stdout.flush()

        while True:
            r, _, _ = select.select([sys.stdin], [], [], 0.1)
            if r:
                ch = sys.stdin.read(1)
                if ch in ("q", "Q", "\x03"):
                    break
                if ch == " ":
                    paused = not paused

            if not paused:
                frame += 1

            now = time.time()
            if stats is None or (not paused and now - last_sample >= 0.5):
                stats, prev_cpu, prev_net = collect_stats(
                    prev_cpu, prev_net, cpu_history
                )
                cpu_history = stats["cpu_history"]
                last_sample = now

            stats["frame"] = frame
            stats["uptime"] = uptime_str()

            logo_lines = LOGOS["kali"].strip("\n").splitlines()
            info = [""] + live_lines(opts, stats)
            body = render_columns(logo_lines, info, opts,
                                  phase=(frame * 0.04) % 1.0)

            cols = shutil.get_terminal_size((100, 40)).columns
            sys.stdout.write(HOME + CLEAR + body)
            sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()
    return 0

# ---------- CLI ----------
HELP = """\
termfetch — live animated system info

Usage: termfetch [OPTIONS]

Options:
  -s, --static       one-shot output (no animation)
  -n, --no-color     disable colors
  -l, --logo NAME    pick a logo
      --json         print as JSON
  -V, --version      show version
  -h, --help         show this help

Live mode keys:
  q       quit
  space   pause/resume
"""

def parse_args(argv):
    opts = {"color": sys.stdout.isatty(), "logo": None,
            "json": False, "static": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--no-color", "-n"):
            opts["color"] = False
        elif a in ("--static", "-s"):
            opts["static"] = True
        elif a == "--json":
            opts["json"] = True
        elif a in ("--logo", "-l") and i + 1 < len(argv):
            i += 1
            opts["logo"] = argv[i]
        elif a in ("--version", "-V"):
            print(f"termfetch {VERSION}")
            sys.exit(0)
        elif a in ("--help", "-h"):
            print(HELP)
            sys.exit(0)
        i += 1
    return opts

def as_json():
    idle, total = read_cpu_times()
    used, rtotal, rpct = ram_stats()
    dused, dtotal, dpct = disk_stats()
    rx, tx = net_bytes()
    return json.dumps({
        "user": os.environ.get("USER"),
        "host": platform.node(),
        "os": distro(),
        "kernel": platform.release(),
        "uptime": uptime_str(),
        "shell": shell(),
        "wm": wm(),
        "cpu": cpu_model(),
        "ram_used_mb": round(used / 1024),
        "ram_total_mb": round(rtotal / 1024),
        "disk_used_gb": round(dused / 1024**3, 1),
        "disk_total_gb": round(dtotal / 1024**3, 1),
        "gpu": gpu(),
        "display": resolution(),
        "net_rx_bytes": rx,
        "net_tx_bytes": tx,
        "procs": proc_count(),
    }, indent=2)

def main(argv):
    opts = parse_args(argv)

    if opts["json"]:
        print(as_json())
        return 0

    if not opts["color"]:
        opts["accent"] = ""
        opts["reset"] = ""
    else:
        opts["accent"] = fg(208)
        opts["reset"] = RESET

    if opts["static"] or not sys.stdout.isatty():
        print(render_static(opts))
        return 0

    return run_live(opts)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
